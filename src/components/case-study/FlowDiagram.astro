---
// A multi-panel flow diagram, drawn in HTML/CSS rather than shipped as a raster
// image: it stays crisp at any zoom, inherits the site's type and tokens, and
// each panel can stack on narrow screens instead of shrinking to illegibility.
//
// A panel is a vertical sequence of rows. Rows connect to the row above with a
// drawn stem, so the reading order and the DOM order are the same thing.
export interface Row {
  // step   — a standard box in the flow
  // decision — a diamond branch point
  // split  — sibling destinations, joined by a bracket
  // chips  — a dense set of peers (kept as one row so it can't dominate)
  // note   — unboxed commentary, no stem
  type: 'step' | 'decision' | 'split' | 'chips' | 'note';
  label?: string;
  note?: string;
  items?: string[];
  emphasis?: boolean;
}
export interface Panel {
  title: string;
  rows: Row[];
  // give a denser panel more of the row so its content doesn't stack to a column
  wide?: boolean;
}
interface Props {
  title?: string;
  panels: Panel[];
  footnote?: string;
}
const { title, panels, footnote } = Astro.props;
---

<figure class="flow" data-width="wide">
  {title && <figcaption class="flow__title">{title}</figcaption>}

  <div
    class="flow__panels"
    style={`--cols:${panels.map((p) => (p.wide ? '1.6fr' : '1fr')).join(' ')}`}
  >
    {
      panels.map((panel) => (
        <section class="flow__panel">
          <h4 class="flow__panel-title">{panel.title}</h4>

          {panel.rows.map((row) => (
            <div class:list={['flow__row', `flow__row--${row.type}`]}>
              {row.type === 'step' && (
                <div class:list={['flow__node', row.emphasis && 'flow__node--lead']}>
                  <span>{row.label}</span>
                  {row.note && <em class="flow__node-note">{row.note}</em>}
                </div>
              )}

              {row.type === 'decision' && (
                <div class="flow__decision">
                  <span class="flow__diamond" aria-hidden="true" />
                  <span class="flow__decision-label">{row.label}</span>
                </div>
              )}

              {row.type === 'split' && (
                <div class="flow__split" style={`--n:${row.items?.length ?? 1}`}>
                  {row.items?.map((item) => (
                    <div class="flow__node flow__node--sm">
                      <span>{item}</span>
                    </div>
                  ))}
                </div>
              )}

              {row.type === 'chips' && (
                <div class="flow__chips-wrap">
                  {row.label && <p class="flow__chips-label">{row.label}</p>}
                  <ul class="flow__chips">
                    {row.items?.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  {row.note && <p class="flow__chips-note">{row.note}</p>}
                </div>
              )}

              {row.type === 'note' && <p class="flow__note">{row.label}</p>}
            </div>
          ))}
        </section>
      ))
    }
  </div>

  {footnote && <p class="flow__footnote">{footnote}</p>}
</figure>

<style>
  .flow {
    /* one hairline colour and one arrowhead geometry for every connector, so
       stems and heads can never drift apart */
    --flow-line: #cfcfcf;
    --flow-head-w: 4px;
    --flow-head-h: 7px;

    margin: clamp(2rem, 5vw, 4rem) 0;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }

  .flow__title {
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
    text-align: center;
    font-weight: 700;
    font-size: clamp(1.05rem, 2.2vw, 1.4rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .flow__panels {
    display: grid;
    grid-template-columns: var(--cols);
    gap: clamp(1rem, 2.5vw, 2rem);
    /* stretch, not start: equal-height panels keep the divider rules uniform */
    align-items: stretch;
  }

  .flow__panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* panels are peers, not a sequence: a rule separates them without implying flow */
    border-left: 1px solid var(--line);
    padding-inline: clamp(0.5rem, 1.5vw, 1rem);
  }
  .flow__panel:first-child {
    border-left: 0;
  }

  .flow__panel-title {
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  /* Every row after the first draws its own incoming stem, so adding or
     reordering rows never leaves a dangling connector. */
  .flow__row {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
  }
  .flow__row + .flow__row {
    margin-top: 28px;
  }
  .flow__row + .flow__row::before {
    content: '';
    position: absolute;
    top: -28px;
    left: 50%;
    width: 1px;
    height: 28px;
    background: var(--flow-line);
  }
  /* a solid triangle, not two rotated borders: a real arrowhead rather than a
     chevron that reads as more line-work */
  .flow__row + .flow__row::after {
    content: '';
    position: absolute;
    top: calc(var(--flow-head-h) * -1);
    left: 50%;
    width: 0;
    height: 0;
    border-left: var(--flow-head-w) solid transparent;
    border-right: var(--flow-head-w) solid transparent;
    border-top: var(--flow-head-h) solid var(--flow-line);
    transform: translateX(-50%);
  }
  /* a split's incoming line feeds the bracket, and the bracket's own stems carry
     the heads — an arrowhead here would point at a line junction, not a node */
  .flow__row--split::after {
    display: none;
  }

  /* notes are commentary, not a step: no stem into them */
  .flow__row--note + .flow__row::before,
  .flow__row--note + .flow__row::after,
  .flow__row--note::before,
  .flow__row--note::after {
    display: none;
  }
  .flow__row--note {
    margin-top: 0.75rem !important;
  }

  .flow__node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    width: 100%;
    max-width: 15rem;
    padding: 0.6rem 0.75rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-align: center;
    font-size: var(--text-small);
    line-height: 1.3;
    color: var(--ink);
  }
  .flow__node--lead {
    background: var(--ink);
    color: var(--surface);
    border-color: var(--ink);
    font-weight: 600;
  }
  .flow__node--sm {
    padding: 0.45rem 0.4rem;
    font-size: 0.78rem;
  }
  .flow__node-note {
    font-size: 0.72rem;
    font-style: italic;
    color: var(--ink-2);
  }
  .flow__node--lead .flow__node-note {
    color: var(--dark-ink-2);
  }

  /* Siblings share one bracket. The horizontal rule stops at the centre of the
     outer children, which is why the inset is half a column. */
  .flow__split {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n, 2), 1fr);
    gap: 0.5rem;
    width: 100%;
    padding-top: 18px;
  }
  .flow__split::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(100% / var(--n) / 2);
    right: calc(100% / var(--n) / 2);
    height: 1px;
    background: var(--flow-line);
  }
  .flow__split > * {
    position: relative;
  }
  .flow__split > *::before {
    content: '';
    position: absolute;
    top: -18px;
    left: 50%;
    width: 1px;
    height: 18px;
    background: var(--flow-line);
  }
  /* each branch gets its own head, matching the vertical connectors */
  .flow__split > *::after {
    content: '';
    position: absolute;
    top: calc(var(--flow-head-h) * -1);
    left: 50%;
    width: 0;
    height: 0;
    border-left: var(--flow-head-w) solid transparent;
    border-right: var(--flow-head-w) solid transparent;
    border-top: var(--flow-head-h) solid var(--flow-line);
    transform: translateX(-50%);
  }

  .flow__decision {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 4.5rem;
  }
  .flow__diamond {
    position: absolute;
    width: 3.4rem;
    height: 3.4rem;
    background: var(--bg);
    border: 1px solid var(--flow-line);
    transform: rotate(45deg);
    border-radius: 4px;
  }
  .flow__decision-label {
    position: relative;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .flow__chips-wrap {
    width: 100%;
  }
  .flow__chips-label {
    margin-bottom: 0.5rem;
    text-align: center;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-2);
  }
  .flow__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow__chips li {
    padding: 0.3rem 0.6rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--ink);
  }
  .flow__chips-note {
    margin-top: 0.6rem;
    text-align: center;
    font-size: 0.72rem;
    font-style: italic;
    color: var(--ink-2);
  }

  .flow__note {
    max-width: 15rem;
    text-align: center;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  .flow__footnote {
    margin-top: clamp(1.5rem, 3vw, 2rem);
    padding: 0.75rem 1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    text-align: center;
    font-weight: 600;
    font-size: var(--text-small);
    color: var(--accent-text);
  }

  /* Stack the panels rather than shrink them: three columns of boxed text is
     unreadable on a phone, which is the failure mode of the raster original. */
  @media (max-width: 720px) {
    .flow__panels {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .flow__panel {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-top: 1.5rem;
    }
    .flow__panel:first-child {
      border-top: 0;
      padding-top: 0;
    }
  }
</style>
